<Window x:Class="Seguradora.Apresentacao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Seguradora.Apresentacao"
        mc:Ignorable="d"
        Title="Seguradora - Cadastro de Clientes" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized"
        Background="#F0F2F5" FontFamily="Segoe UI">

    <!-- 1. Removemos a margem superior do Grid para o Menu colar no topo -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Linha 0: Menu -->
            <RowDefinition Height="Auto"/>
            <!-- Linha 1: Campos de Cadastro -->
            <RowDefinition Height="*"/>
            <!-- Linha 2: DataGrid -->
        </Grid.RowDefinitions>

        <!-- 2. MENU SUPERIOR (Fica na Linha 0, no topo) -->
        <Menu Grid.Row="0" Background="White" Foreground="#333333" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" FontSize="14" VerticalAlignment="Top">
            <MenuItem Header="Cadastrar" Padding="15,10" Background="Transparent">
                <MenuItem Header="Cliente" Click="MenuCadastrarCliente_Click" Padding="15,8">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#333333"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 3. CAMPOS DE Pesquisa (Ficam na Linha 1, abaixo do menu) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,20,20,10">
            <TextBlock Text="Pesquisar Nome:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtPesquisaNome" Width="150" Margin="0,0,15,0"/>

            <Button x:Name="btnPesquisar"
                Content="Pesquisar"
                Width="100" 
                Height="25"
                Click="btnPesquisar_Click"/>

            <Button x:Name="btnLimpar"
                Content="Limpar Filtro"
                Width="100" 
                Height="25"
                Margin="10,0,0,0"
                Click="btnLimpar_Click"/>

            <!--TextBlock Text="CPF:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtCpf" Width="120" Margin="0,0,15,0"/-->

            <!--Button x:Name="btnSalvar"
                    Content="Salvar Cliente"
                    Width="100" Margin="0,0,15,0" Click="btnSalvar_Click"/-->

            <!--Button x:Name="btnAbrirCadastro" 
                    Content="Abrir Tela de Cadastro" 
                    Width="150" 
                    Click="btnAbrirCadastro_Click"/-->
        </StackPanel>

        <!-- 4. DATAGRID (Fica na Linha 2, ocupando o resto da tela) -->
        <DataGrid Grid.Row="2" x:Name="dgClientes" AutoGenerateColumns="True" Margin="20,10,20,20"/>
    </Grid>
</Window>