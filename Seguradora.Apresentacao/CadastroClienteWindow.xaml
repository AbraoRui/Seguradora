<Window x:Class="Seguradora.Apresentacao.CadastroClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Cliente" Height="350" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Novo Cliente" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Nome -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Nome Completo (obrigatório):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNome" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- CPF -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="CPF (obrigatório):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCpf" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Email -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="E-mail (opcional):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Botões -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="btnCancelar" Content="Cancelar" Width="90" Height="30" Margin="0,0,10,0" Click="btnCancelar_Click"/>
            <Button x:Name="btnSalvar" Content="Salvar" Width="90" Height="30" Background="#4CAF50" Foreground="White" Click="btnSalvar_Click"/>
        </StackPanel>
    </Grid>
</Window>